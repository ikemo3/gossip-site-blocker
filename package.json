{
  "name": "gossip-site-blocker",
  "version": "1.17.1",
  "license": "MIT",
  "author": "Hideki Ikemoto",
  "type": "module",
  "scripts": {
    "archive": "tsx ./scripts/archive.ts",
    "build": "run-s build:*",
    "build:vite": "vite build",
    "build:manifest": "tsx ./scripts/make_manifest.ts",
    "dev": "vite",
    "fix": "ESLINT_USE_FLAT_CONFIG=true eslint --fix .",
    "format": "run-s format:*",
    "format:prettier": "prettier --write .",
    "format:sort-package-json": "sort-package-json",
    "lint": "run-s lint:*",
    "lint:dep": "depcruise .",
    "lint:eslint": "ESLINT_USE_FLAT_CONFIG=true eslint .",
    "lint:prettier": "prettier --check .",
    "lint:sort-package-json": "sort-package-json --check",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "tabbyjs": "^12.0.3",
    "vanjs-core": "^1.6.2"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "date-fns": "4.4.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-junit": "^9.0.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "sort-package-json": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zip-a-folder": "7.0.1"
  },
  "packageManager": "pnpm@12.18.0"
}
