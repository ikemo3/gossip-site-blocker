{
  "name": "gossip-site-blocker",
  "version": "1.17.1",
  "license": "MIT",
  "author": "Hideki Ikemoto",
  "type": "module",
  "scripts": {
    "archive": "tsx ./scripts/archive.ts",
    "build": "run-s build:*",
    "build:vite": "vite build",
    "build:manifest": "tsx ./scripts/make_manifest.ts",
    "dev": "vite",
    "fix": "run-s fix:*",
    "fix:oxlint": "oxlint --fix --report-unused-disable-directives",
    "format": "run-s format:*",
    "format:oxfmt": "oxfmt",
    "lint": "run-s lint:*",
    "lint:dep": "depcruise .",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint --report-unused-disable-directives",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "tabbyjs": "^12.0.3",
    "vanjs-core": "^1.6.2"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "date-fns": "4.4.0",
    "dependency-cruiser": "^18.7.2",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zip-a-folder": "7.0.1"
  },
  "packageManager": "pnpm@12.21.0"
}
